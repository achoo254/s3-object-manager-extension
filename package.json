{
  "name": "s3-object-manager-extension",
  "description": "Browser extension for managing objects on any S3-compatible endpoint",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build && wxt build -b edge",
    "zip": "wxt zip && wxt zip -b edge",
    "postinstall": "wxt prepare",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:local": "node scripts/seed-local-s3.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "build:e2e": "wxt build --mode e2e",
    "test:e2e": "playwright test",
    "perf": "playwright test --config playwright.tools.config.ts measure-performance",
    "screenshots": "playwright test --config playwright.tools.config.ts store-screenshots"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@mdi/js": "7.4.47",
    "@smithy/md5-js": "4.5.2",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vuetify": "3.13.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@playwright/test": "1.63.0",
    "@smithy/fetch-http-handler": "5.8.0",
    "@smithy/types": "4.19.0",
    "@types/node": "24.13.6",
    "@wxt-dev/module-vue": "1.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11",
    "wxt": "0.21.4"
  }
}
