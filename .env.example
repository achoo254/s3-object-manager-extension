# Regex of terms that must never appear in tracked files or commit messages.
# Used by the local git hooks (scripts/install-git-hooks.sh). Keep the value outside the repo.
FORBIDDEN_TERMS_REGEX=

# Local S3 server used by scripts/seed-local-s3.mjs (defaults match docker/seaweedfs-s3.json).
LOCAL_S3_ENDPOINT=
LOCAL_S3_ACCESS_KEY_ID=
LOCAL_S3_SECRET_ACCESS_KEY=
